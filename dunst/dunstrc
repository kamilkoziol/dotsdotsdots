[global]
font = Hack Nerd Font Mono 10
frame_width = 1
origin = top-right
frame_color = "#313244"
separator_color = frame
highlight = "#cba6f7"

[urgency_low]
background = "#1e1e2e"
foreground = "#a6adc8"

[urgency_normal]
background = "#1e1e2e"
foreground = "#cdd6f4"

[urgency_critical]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#f38ba8"
